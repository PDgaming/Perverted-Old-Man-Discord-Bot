{
  "chat_model": "openai/gpt-oss-20b",
  "history_file_path": "data/chat_history.json",
  "max_tool_turns": 4,
  "max_tokens": 1000,
  "temperature": 0.7,
  "max_history": 10,
  "system_prompt_file": "prompts/system.md",
  "offline_message": "William's brain is taking a nap (offline mode, no LLM calls). He'll be back shortly, dearie.",
  "router": {
    "enabled": true,
    "backend": "clef",
    "model": "clef-flash",
    "tev_model": "tev1:0.8b",
    "timeout_s": 8.0,
    "route_confidence_min": 0.35,
    "remember_fire": 0.7,
    "remember_skip": 0.4
  },
  "minecraft": {
    "script_path": "/path/to/your/server/start.sh",
    "working_dir": "/path/to/your/server",
    "script_name": "start.sh",
    "tmux_session": "minecraft",
    "process_match": "minecraft",
    "tunnel_command": "playit",
    "terminal_emulator": "konsole",
    "terminal_args": [
      "--separate",
      "--hide-menubar",
      "-e"
    ]
  },
  "allowed_fetch_domains": [
    "wikipedia.org",
    "minecraft.wiki",
    "gutenberg.org",
    "poetryfoundation.org",
    "bbc.com",
    "bbc.co.uk",
    "apnews.com"
  ],
  "fetch_blocked_message": "Sorry, I can't open links from that site.",
  "max_fetch_chars": 4000
}
